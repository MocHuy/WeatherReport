      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\SEQ_Build_DW\Create_DIM_FACT_Table"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{536ED85A-7C41-4BEE-A9CD-49AB375445A2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create_DIM_FACT_Table"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{29D76AE5-6636-4BD7-A4C2-544EF8F1E636}"
              SQLTask:SqlStatementSource="-- DIM_DATE&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_DATE' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_DATE (&#xA;        DateID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        FullDate DATE,&#xA;        Day INT,&#xA;        Month INT,&#xA;        Quarter INT,&#xA;        Year INT&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_LOCATION&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_LOCATION' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_LOCATION (&#xA;        LocationID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        Country NVARCHAR(150),&#xA;        LocationName NVARCHAR(150),&#xA;        Latitude DECIMAL(9,6),&#xA;        Longitude DECIMAL(9,6),&#xA;        Timezone NVARCHAR(100),&#xA;        Continent NVARCHAR(100),&#xA;        Region NVARCHAR(100),&#xA;        Capital NVARCHAR(100)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_CONDITION&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_CONDITION' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_CONDITION (&#xA;        ConditionID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ConditionText NVARCHAR(100),&#xA;        ConditionGroup NVARCHAR(100)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_AIRQUALITY&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_AIRQUALITY' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_AIRQUALITY (&#xA;        AirQualityID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        USEPAIndex INT,&#xA;        AirQualityLevel NVARCHAR(50),&#xA;        DEFRAIndex INT,&#xA;        DEFRALevel NVARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_TIME&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_TIME' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_TIME (&#xA;        TimeID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        Hour TINYINT,&#xA;        Minute TINYINT,&#xA;        TimePeriod NVARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_UV&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_UV' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_UV (&#xA;        UVID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        UVLevel NVARCHAR(50),&#xA;        UVMin DECIMAL(4,1),&#xA;        UVMax DECIMAL(4,1),&#xA;        ProtectionLevel NVARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_WIND&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_WIND' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_WIND (&#xA;        WindID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        WindDirection NVARCHAR(20),&#xA;        WindDegree INT,&#xA;        WindLevel NVARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- DIM_PRECIPITATION&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'DIM_PRECIPITATION' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE DIM_PRECIPITATION (&#xA;        PrecipitationID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        PrecipitationLevel NVARCHAR(20),&#xA;        IsRainy BIT&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- FACT_WEATHER&#xA;IF NOT EXISTS (&#xA;    SELECT * FROM sysobjects&#xA;    WHERE name = 'FACT_WEATHER' AND xtype = 'U'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE FACT_WEATHER (&#xA;        WeatherFactID INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;        DateID INT,&#xA;        LocationID INT,&#xA;        ConditionID INT,&#xA;        AirQualityID INT,&#xA;        UVID INT,&#xA;        WindID INT,&#xA;        PrecipitationID INT,&#xA;        TimeID INT,&#xA;&#xA;        ObservationTime TIME,&#xA;        TemperatureCelsius DECIMAL(5,2),&#xA;        WindKph DECIMAL(6,2),&#xA;        PrecipMm DECIMAL(7,2),&#xA;        Humidity INT,&#xA;        VisibilityKm DECIMAL(6,2),&#xA;        UVIndex DECIMAL(5,2),&#xA;        PM2_5 DECIMAL(10,2),&#xA;        PM10 DECIMAL(10,2)&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
